+#[cfg(target_os = "wasi")]
+mod clippy;
+
 fn main() -> ExitCode {
+    #[cfg(target_os = "wasi")]
+    if std::env::var_os("RUSTC_CLIPPY").is_some() {
+        return clippy::main();
+    }
     rustc_driver::main()
 }
