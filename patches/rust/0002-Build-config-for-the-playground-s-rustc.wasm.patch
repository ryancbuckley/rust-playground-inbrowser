From ae8db457437080c1469458fe66eb9682929a4dee Mon Sep 17 00:00:00 2001
From: Ryan Buckley <10402042+ryancbuckley@users.noreply.github.com>
Date: Tue, 20 Oct 2026 17:03:53 -0400
Subject: [PATCH] Build config for the playground's rustc.wasm

---
 bootstrap.toml | 30 +++++++++++++++---------------
 comment.txt    | 18 ------------------
 2 files changed, 15 insertions(+), 33 deletions(-)
 delete mode 100644 comment.txt

diff --git a/bootstrap.toml b/bootstrap.toml
index 58061acfa..00f5f33c2 100644
--- a/bootstrap.toml
+++ b/bootstrap.toml
@@ -1,6 +1,9 @@
-# Includes one of the default files in src/bootstrap/defaults
+# Build a rustc that runs on wasm32-wasip1-threads and compiles to
+# wasm32-wasip1-threads through rustc_codegen_cranelift +
+# cranelift-wasm-backend. The std it links against is compiled natively by
+# LLVM, like rustup's.
 profile = "compiler"
-change-id = 9999999
+change-id = "ignore"
 
 [llvm]
 download-ci-llvm = true
@@ -12,27 +15,24 @@ llvm-tools = false
 llvm-bitcode-linker = false
 debug = false
 debuginfo-level = 0
+download-rustc = false
+incremental = false
 
 [build]
 docs = false
 extended = false
 tools = []
-host = ["wasm32-wasip1"]
-target = ["x86_64-unknown-linux-gnu"]
+host = ["wasm32-wasip1-threads"]
+target = ["wasm32-wasip1-threads"]
 
 [install]
 prefix = "dist"
 sysconfdir = "etc"
 
-[target.'wasm32-wasip1']
-wasi-root = "wasi-sdk-32.0-x86_64-linux/share/wasi-sysroot"
-linker = "wasi-sdk-32.0-x86_64-linux/bin/clang"
+[target.wasm32-wasip1-threads]
+wasi-root = "/path/to/browser_rust_playground/tools/wasi-sdk-34.0-arm64-macos/share/wasi-sysroot"
+linker = "/path/to/browser_rust_playground/tools/wasi-sdk-34.0-arm64-macos/bin/clang"
+cc = "/path/to/browser_rust_playground/tools/wasi-sdk-34.0-arm64-macos/bin/clang"
+cxx = "/path/to/browser_rust_playground/tools/wasi-sdk-34.0-arm64-macos/bin/clang++"
+ar = "/path/to/browser_rust_playground/tools/wasi-sdk-34.0-arm64-macos/bin/llvm-ar"
 codegen-backends = ["cranelift"]
-
-[target.'wasm32-wasip1-threads']
-wasi-root = "wasi-sdk-32.0-x86_64-linux/share/wasi-sysroot"
-linker = "wasi-sdk-32.0-x86_64-linux/bin/clang"
-codegen-backends = ["cranelift"]
-
-[target.'x86_64-unknown-linux-gnu']
-cc = "gcc"
diff --git a/comment.txt b/comment.txt
deleted file mode 100644
index 547c4c220..000000000
--- a/comment.txt
+++ /dev/null
@@ -1,18 +0,0 @@
-Got a new version up. This time all logic to handle using different codegen backends for the different stages, so you don't need to do a multi stage process.
-
-* Make sure you are running on Linux.
-* Clone https://github.com/bjorn3/rust
-* Checkout the `compile_rustc_for_wasm20` branch
-* Download and extract https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-24/wasi-sdk-32.0-x86_64-linux.tar.gz into the rust checkout.
-* Run `WASI_SDK_PATH=$(pwd)/wasi-sdk-32.0-x86_64-linux ./x.py install` to build the compiler and install it into the dist dir.
-* Use `wasmtime run --dir tmp::/ --dir dist dist/bin/rustc.wasm --sysroot dist --target x86_64-unknown-linux-gnu` to run rustc.
-
-Note that linking is not supported as wasi doesn't allow spawning executables. You can use something like the following to compile using the wasm32-wasi rustc and then link using native gcc:
-
-```
-$ mkdir tmp
-$ echo 'fn main() { println!("Hello World!"); }' | wasmtime run -Sthreads=y -Spreview2=n --dir tmp::/ --dir dist --env RUST_MIN_STACK=16777216 dist/bin/rustc.wasm - --sysroot dist --target x86_64-unknown-linux-gnu -Csave-temps
-$ gcc -fuse-ld=lld tmp/rustc*/symbols.o tmp/rust_out.* dist/lib/rustlib/x86_64-unknown-linux-gnu/lib/lib*.rlib -o rust_out
-$ ./rust_out
-Hello World!
-```
