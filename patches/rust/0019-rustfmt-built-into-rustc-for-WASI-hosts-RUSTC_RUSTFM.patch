 #[cfg(target_os = "wasi")]
 mod clippy;
+#[cfg(target_os = "wasi")]
+mod rustfmt;
 
 fn main() -> ExitCode {
     #[cfg(target_os = "wasi")]
     if std::env::var_os("RUSTC_CLIPPY").is_some() {
         return clippy::main();
     }
