-cranelift-object = { version = "0.136.2", default-features = false }
+cranelift-codegen = { version = "0.137.0", default-features = false, features = ["std", "timing", "unwind"] }
+cranelift-frontend = { version = "0.137.0" }
+cranelift-module = { version = "0.137.0" }
+cranelift-native = { version = "0.137.0" }
+cranelift-jit = { version = "0.137.0", optional = true }
+cranelift-object = { version = "0.137.0", default-features = false }
