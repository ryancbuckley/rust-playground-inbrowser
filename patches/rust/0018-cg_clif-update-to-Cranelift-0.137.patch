 object = { version = "0.40.0", default-features = false, features = ["std", "read_core", "write", "archive", "coff", "elf", "macho", "pe"] }
@@ -65,7 +65,7 @@ rustc_target = { path = "../rustc_target" }
 # A compiler running on wasm only targets wasm, through clif-to-wasm,
 # and needs none of Cranelift's native backends.
