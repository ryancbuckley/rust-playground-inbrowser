+/// Runs the linker through the `playground.spawn` import of a WASI host
+/// (such as the browser playground), which runs `argv[0]` with arguments
+/// `argv` to completion on the same filesystem and output streams, and
+/// returns its exit code (or -1 if it cannot run it).
+#[cfg(target_os = "wasi")]
+fn exec_linker_wasi(cmd: &Command) -> io::Result<Output> {
+    use std::ffi::{CString, c_char};
+
+    #[link(wasm_import_module = "playground")]
+    unsafe extern "C" {
+        fn spawn(argv: *const *const c_char, argc: usize) -> i32;
+    }
+
+    let cmd = cmd.command();
+    let mut argv = vec![CString::new(cmd.get_program().as_encoded_bytes())?];
+    for arg in cmd.get_args() {
+        argv.push(CString::new(arg.as_encoded_bytes())?);
+    }
+    let ptrs: Vec<*const c_char> = argv.iter().map(|a| a.as_ptr()).collect();
+    match unsafe { spawn(ptrs.as_ptr(), ptrs.len()) } {
+        0 => Ok(Output { status: Default::default(), stdout: vec![], stderr: vec![] }),
+        -1 => Err(io::Error::new(io::ErrorKind::NotFound, "the host cannot run the linker")),
+        code => Err(io::Error::other(format!("the linker exited with status {code}"))),
+    }
+}
