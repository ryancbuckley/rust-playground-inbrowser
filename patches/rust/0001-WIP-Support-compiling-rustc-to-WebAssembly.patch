--- /dev/null
+++ b/compiler/rustc_codegen_cranelift/src/wasm.rs
@@ -0,0 +1,80 @@
+//! Compiling for wasm targets through `cranelift-wasm-backend`, which turns
+//! the CLIF of each function into wasm and writes relocatable wasm objects
+//! that `wasm-ld` or `wild` link with the (LLVM-compiled) sysroot.
+
+use cranelift_codegen::isa::OwnedTargetIsa;
+use cranelift_codegen::settings;
+use cranelift_wasm_backend::object_module::{
+    ObjectOptions, THREADS_FEATURES, WasmObjectModule, frontend_isa,
+};
+use rustc_session::Session;
+use rustc_target::spec::Arch;
+
+pub(crate) fn is_wasm(sess: &Session) -> bool {
+    matches!(sess.target.arch, Arch::Wasm32 | Arch::Wasm64)
+}
+
+fn memory64(sess: &Session) -> bool {
+    sess.target.arch == Arch::Wasm64
+}
+
+/// The target features enabled by the target spec and `-Ctarget-feature`.
+pub(crate) fn target_features(sess: &Session) -> Vec<String> {
+    target_features_of(&sess.target, &sess.opts.cg.target_feature)
+}
+
+pub(crate) fn target_features_of(target: &rustc_target::spec::Target, cg: &str) -> Vec<String> {
+    let mut features: Vec<String> = Vec::new();
+    for list in [&*target.options.features, cg] {
+        for f in list.split(',') {
+            if let Some(name) = f.strip_prefix('+') {
+                if !features.iter().any(|x| x == name) {
+                    features.push(name.to_owned());
+                }
+            } else if let Some(name) = f.strip_prefix('-') {
+                features.retain(|x| x != name);
+            }
+        }
+    }
+    features
+}
+
+/// Whether the program has threads (shared memory and TLS).
+pub(crate) fn threads(sess: &Session) -> bool {
+    target_features(sess).iter().any(|f| f == "atomics")
+}
+
+pub(crate) fn build_isa(sess: &Session, flags: settings::Flags) -> OwnedTargetIsa {
+    frontend_isa(flags, memory64(sess))
+        .unwrap_or_else(|err| sess.dcx().fatal(format!("failed to build TargetIsa: {err}")))
+}
+
+pub(crate) fn make_module(sess: &Session, isa: OwnedTargetIsa) -> WasmObjectModule {
+    let mut config = cranelift_wasm_backend::Config::default();
+    config.module.memory64 = memory64(sess);
+    // The sysroot is compiled by LLVM: use its convention for multiple
+    // return values.
+    config.module.demote_multi_results = true;
+    let threads = threads(sess);
+    let mut features: Vec<String> = THREADS_FEATURES.iter().map(|&f| f.to_owned()).collect();
+    if !threads {
+        features.retain(|f| f != "atomics");
+    }
+    for f in target_features(sess) {
+        if !features.contains(&f) {
+            features.push(f);
+        }
+    }
+    WasmObjectModule::new(
+        isa,
+        ObjectOptions {
+            config,
+            threads,
+            features,
+            // Functions using what the backend does not support yet trap
+            // when called, with a warning at compile time.
+            stub_unsupported: std::env::var("CG_CLIF_WASM_STRICT").as_deref() != Ok("1"),
+            libcall_names: cranelift_module::default_libcall_names(),
+        },
+    )
+}
