+/// The object file a codegen unit is compiled into: a native one through
+/// `cranelift-object`, or a wasm one through `cranelift-wasm-backend`.
+pub(crate) enum AotObject {
+    Native(UnwindModule<ObjectModule>),
+    Wasm(cranelift_wasm_backend::object_module::WasmObjectModule),
+}
+
+macro_rules! with_module {
+    ($self:expr, $m:ident => $e:expr) => {
+        match $self {
+            AotObject::Native($m) => $e,
+            AotObject::Wasm($m) => $e,
+        }
+    };
+}
+
+impl Module for AotObject {
+    fn isa(&self) -> &dyn cranelift_codegen::isa::TargetIsa {
+        with_module!(self, m => m.isa())
+    }
+
+    fn declarations(&self) -> &cranelift_module::ModuleDeclarations {
+        with_module!(self, m => m.declarations())
+    }
+
+    fn declare_function(
+        &mut self,
+        name: &str,
+        linkage: Linkage,
+        signature: &Signature,
+    ) -> cranelift_module::ModuleResult<FuncId> {
+        with_module!(self, m => m.declare_function(name, linkage, signature))
+    }
+
+    fn declare_anonymous_function(
+        &mut self,
+        signature: &Signature,
+    ) -> cranelift_module::ModuleResult<FuncId> {
+        with_module!(self, m => m.declare_anonymous_function(signature))
+    }
+
+    fn declare_data(
+        &mut self,
+        name: &str,
+        linkage: Linkage,
+        writable: bool,
+        tls: bool,
+    ) -> cranelift_module::ModuleResult<DataId> {
+        with_module!(self, m => m.declare_data(name, linkage, writable, tls))
+    }
+
+    fn declare_anonymous_data(
+        &mut self,
+        writable: bool,
+        tls: bool,
+    ) -> cranelift_module::ModuleResult<DataId> {
+        with_module!(self, m => m.declare_anonymous_data(writable, tls))
+    }
+
+    fn define_function_with_control_plane(
+        &mut self,
+        func: FuncId,
+        ctx: &mut Context,
+        ctrl_plane: &mut cranelift_codegen::control::ControlPlane,
+    ) -> cranelift_module::ModuleResult<()> {
+        with_module!(self, m => m.define_function_with_control_plane(func, ctx, ctrl_plane))
+    }
+
+    fn define_function_bytes(
