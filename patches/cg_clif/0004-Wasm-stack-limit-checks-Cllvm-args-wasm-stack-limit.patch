diff --git a/src/config.rs b/src/config.rs
index 31bc0374..39e7a126 100644
--- a/src/config.rs
+++ b/src/config.rs
@@ -34,6 +34,8 @@ pub fn from_opts(opts: &[String]) -> Result<Self, String> {
             }
             match &**opt {
                 "jit-mode" => config.jit_mode = true,
+                // Read where wasm objects are made: see `wasm::stack_limit`.
+                "wasm-stack-limit" => {}
                 _ => return Err(format!("Unknown option `{}`", opt)),
             }
         }
diff --git a/src/wasm.rs b/src/wasm.rs
index 9c03068f..fe1710b5 100644
--- a/src/wasm.rs
+++ b/src/wasm.rs
@@ -48,6 +48,12 @@ pub(crate) fn threads(sess: &Session) -> bool {
     target_features(sess).iter().any(|f| f == "atomics")
 }
 
+/// Whether functions check their stack frames against `__stack_limit`
+/// (`-Cllvm-args=wasm-stack-limit`), which the program must define.
+pub(crate) fn stack_limit(sess: &Session) -> bool {
+    sess.opts.cg.llvm_args.iter().any(|a| a == "wasm-stack-limit")
+}
+
 pub(crate) fn build_isa(sess: &Session, flags: settings::Flags) -> OwnedTargetIsa {
     frontend_isa(flags, address_type(sess))
         .unwrap_or_else(|err| sess.dcx().fatal(format!("failed to build TargetIsa: {err}")))
@@ -86,20 +92,15 @@ pub(crate) fn make_module(tcx: TyCtxt<'_>, isa: OwnedTargetIsa) -> WasmObjectMod
             features.push(f);
         }
     }
-    WasmObjectModule::new(
-        isa,
-        ObjectOptions {
-            config,
-            threads,
-            features,
-            // Functions using what the backend does not support yet trap
-            // when called, with a warning at compile time.
-            stub_unsupported: std::env::var("CG_CLIF_WASM_STRICT").as_deref() != Ok("1"),
-            libcall_names: cranelift_module::default_libcall_names(),
-            import_names: {
-                let names = wasm_import_names(tcx);
-                Box::new(move |symbol| names.get(symbol).cloned())
-            },
-        },
-    )
+    let mut options = ObjectOptions::default();
+    options.config = config;
+    options.threads = threads;
+    options.stack_limit = stack_limit(sess);
+    options.features = features;
+    // Functions using what the backend does not support yet trap when
+    // called, with a warning at compile time.
+    options.stub_unsupported = std::env::var("CG_CLIF_WASM_STRICT").as_deref() != Ok("1");
+    let names = wasm_import_names(tcx);
+    options.import_names = Box::new(move |symbol| names.get(symbol).cloned());
+    WasmObjectModule::new(isa, options)
 }
